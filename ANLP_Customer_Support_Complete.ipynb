    "# ============================================================\n",
    "# RAG PIPELINE — FAISS Vector Index + Semantic Search\n",
    "# ============================================================\n",
    "\n",
    "print(\"Loading sentence transformer for RAG...\")\n",
    "embedder = SentenceTransformer('all-MiniLM-L6-v2', device=device)\n",
    "print(\"✅ Embedder loaded!\")\n",
    "\n",
    "# Build FAISS index\n",
    "kb_issues = [kb['issue'] for kb in knowledge_base]\n",
    "kb_responses = [kb['response'] for kb in knowledge_base]\n",
    "\n",
    "print(\"Building FAISS vector index...\")\n",
    "issue_embeddings = embedder.encode(kb_issues, convert_to_numpy=True, show_progress_bar=True)\n",
    "\n",
    "# L2-normalize for cosine similarity\n",
    "faiss.normalize_L2(issue_embeddings)\n",
    "\n",
    "# Create FAISS index\n",
    "dimension = issue_embeddings.shape[1]\n",
    "index = faiss.IndexFlatIP(dimension)  # Inner product = cosine similarity after normalization\n",
    "index.add(issue_embeddings)\n",
    "\n",
    "print(f\"✅ FAISS Index built: {index.ntotal} vectors, dimension={dimension}\")\n",
    "\n",
    "def retrieve_relevant_responses(query, top_k=3):\n",
    "    \"\"\"Semantic search over knowledge base\"\"\"\n",
    "    query_emb = embedder.encode([query], convert_to_numpy=True)\n",
    "    faiss.normalize_L2(query_emb)\n",
    "    scores, indices = index.search(query_emb, top_k)\n",
    "    results = []\n",
    "    for score, idx in zip(scores[0], indices[0]):\n",
    "        results.append({\n",
    "            'issue': kb_issues[idx],\n",
    "            'response': kb_responses[idx],\n",
    "            'similarity': float(score)\n",
    "        })\n",
    "    return results\n",
    "\n",
    "# Test retrieval\n",
    "query = \"I got charged twice on my credit card, need a refund\"\n",
    "results = retrieve_relevant_responses(query, top_k=3)\n",
    "print(f\"\\n🔍 Query: '{query}'\")\n",
    "print(\"\\nTop Retrieved Results:\")\n",
    "for i, r in enumerate(results):\n",
    "    print(f\"  [{i+1}] Similarity: {r['similarity']:.3f} | Issue: {r['issue']}\")"
   ]
