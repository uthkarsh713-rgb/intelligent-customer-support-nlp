    "        'friendly': \"Great to hear from you! Happy to help. \"\n",
    "    }\n",
    "\n",
    "    # Sarcasm handling\n",
    "    sarcasm_notice = \"\"\n",
    "    if sarcasm_result['is_sarcastic']:\n",
    "        sarcasm_notice = \"We understand your frustration and the sarcasm in your message — and we completely deserve it. Let us make this right. \"\n",
    "\n",
    "    # Build response\n",
    "    opening = tone_openings.get(tone, tone_openings['professional'])\n",
    "    core_response = best_match['response'] if best_match['similarity'] > 0.3 else \\\n",
    "        \"Thank you for your message. Our specialist team will review your case within 24 hours and get back to you with a personalized solution.\"\n",
    "\n",
