    "# ============================================================\n",
    "# SEVERITY SCORING — Composite Score\n",
    "# ============================================================\n",
    "\n",
    "def compute_severity_score(text, sentiment_result, sarcasm_result, category):\n",
    "    \"\"\"\n",
    "    Severity score (1-10) based on:\n",
    "    - Sentiment polarity\n",
    "    - Sarcasm presence\n",
    "    - Urgency keywords\n",
    "    - Category weight\n",
    "    \"\"\"\n",
    "    score = 5.0  # Base\n",
    "\n",
    "    # Sentiment adjustment\n",
    "    if sentiment_result['sentiment'] == 'negative':\n",
    "        score += 2.0 * sentiment_result['score']\n",
    "    elif sentiment_result['sentiment'] == 'positive':\n",
    "        score -= 2.0\n",
    "\n",
    "    # Sarcasm adds severity\n",
    "    if sarcasm_result['is_sarcastic']:\n",
    "        score += 1.5\n",
    "\n",
    "    # Urgency keywords\n",
    "    urgency_words = ['urgent', 'immediately', 'asap', 'emergency', 'critical',\n",
    "                     'broken', 'fraud', 'stealing', 'lost', 'destroyed']\n",
    "    urgency_count = sum(1 for w in urgency_words if w in text.lower())\n",
    "    score += urgency_count * 0.5\n",
    "\n",
    "    # Category weights\n",
    "    category_weights = {'Complaint': 1.5, 'Billing': 1.3, 'Technical': 1.2,\n",
    "                        'Product': 1.0, 'General': 0.7}\n",
    "    score *= category_weights.get(category, 1.0)\n",
    "\n",
    "    return round(min(max(score, 1.0), 10.0), 1)\n",
    "\n",
    "# Test severity scoring\n",
    "test_ticket = \"I was charged TWICE this month! This is fraud! Fix it IMMEDIATELY or I'm going to my bank!\"\n",
    "sent_result = analyze_sentiment(test_ticket)\n",
    "sarc_result = sarcasm_detector.detect(test_ticket)\n",
    "cat_result  = classify_ticket(test_ticket)\n",
    "severity    = compute_severity_score(test_ticket, sent_result, sarc_result, cat_result['category'])\n",
    "\n",
    "print(\"🚨 FULL TICKET ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "print(f\"Text: {test_ticket}\")\n",
    "print(f\"\\n→ Category:  {cat_result['category']} ({cat_result['confidence']:.0%} confidence)\")\n",
    "print(f\"→ Sentiment: {sent_result['sentiment']} ({sent_result['score']:.0%} confidence)\")\n",
    "print(f\"→ Sarcasm:   {sarc_result['is_sarcastic']} (score: {sarc_result['sarcasm_score']:.2f})\")\n",
    "print(f\"→ Severity:  {severity}/10\")\n",
    "print(f\"→ Priority:  {'HIGH 🔴' if severity >= 7 else 'MEDIUM 🟡' if severity >= 4 else 'LOW 🟢'}\")"
   ]
