    "    temp['severity'] = temp['severity'] + np.random.randint(-1, 2, size=len(temp))\n",
    "    temp['severity'] = temp['severity'].clip(1, 10)\n",
    "    temp['timestamp'] = pd.Timestamp('2024-01-01') + pd.to_timedelta(np.random.randint(0, 180, len(temp)), unit='D')\n",
    "    augmented.append(temp)\n",
    "    ticket_id += len(temp)\n",
    "\n",
    "df = pd.concat([base_df] + augmented, ignore_index=True).head(500)\n",
    "df = df.sample(frac=1, random_state=42).reset_index(drop=True)\n",
