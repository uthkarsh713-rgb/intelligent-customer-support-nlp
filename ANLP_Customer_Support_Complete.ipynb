    "    'General':   ['neutral',  'neutral',  'neutral',  'positive', 'neutral']\n",
    "}\n",
    "\n",
    "# Sarcasm indicators (Complaint category has sarcastic examples)\n",
    "sarcasm_tickets = [\n",
