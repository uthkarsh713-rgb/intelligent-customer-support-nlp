    "# ============================================================\n",
    "# SARCASM DETECTION — Rule-based + Transformer Hybrid\n",
    "# ============================================================\n",
    "\n",
    "import re\n",
    "\n",
    "class SarcasmDetector:\n",
    "    \"\"\"\n",
    "    Hybrid sarcasm detector combining:\n",
    "    1. Cognitive-linguistic patterns (Joshi et al. 2017)\n",
    "    2. Sentiment-context incongruity\n",
    "    3. Punctuation and capitalization patterns\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self):\n",
    "        # Sarcasm marker patterns\n",
    "        self.sarcasm_phrases = [\n",
    "            r'oh wow', r'oh great', r'oh fantastic', r'oh sure',\n",
    "            r'(not)', r'truly impressive', r'clearly.*expert',\n",
    "            r'wow.*really', r'absolutely.*love', r'totally.*great',\n",
    "            r'you must really', r'on a roll', r'just wonderful'\n",
    "        ]\n",
    "        self.positive_words = [\n",
    "            'great', 'fantastic', 'wonderful', 'amazing', 'love',\n",
    "            'impressive', 'excellent', 'perfect', 'brilliant'\n",
    "        ]\n",
    "        self.exclaim_pattern = re.compile(r'!+')\n",
    "        self.caps_pattern = re.compile(r'\\b[A-Z]{2,}\\b')\n",
    "\n",
    "    def detect(self, text):\n",
    "        text_lower = text.lower()\n",
    "        score = 0.0\n",
    "        evidence = []\n",
    "\n",
    "        # Check sarcasm phrases\n",
    "        for pattern in self.sarcasm_phrases:\n",
    "            if re.search(pattern, text_lower):\n",
    "                score += 0.3\n",
    "                evidence.append(f'sarcasm_phrase: {pattern}')\n",
    "\n",
    "        # Positive words in negative context\n",
    "        pos_count = sum(1 for w in self.positive_words if w in text_lower)\n",
    "        if pos_count > 0:\n",
    "            sent = analyze_sentiment(text)\n",
    "            if sent['sentiment'] == 'negative':\n",
    "                score += 0.4 * min(pos_count, 2)\n",
    "                evidence.append('positive_in_negative_context')\n",
    "\n",
    "        # Multiple exclamation marks\n",
    "        exclaims = len(self.exclaim_pattern.findall(text))\n",
    "        if exclaims > 1:\n",
    "            score += 0.1\n",
    "            evidence.append('multiple_exclamations')\n",
    "\n",
    "        # ALL CAPS words\n",
    "        caps = self.caps_pattern.findall(text)\n",
    "        if len(caps) > 0:\n",
    "            score += 0.1\n",
    "            evidence.append(f'caps_words: {caps}')\n",
    "\n",
    "        is_sarcastic = score >= 0.35\n",
    "        return {\n",
    "            'is_sarcastic': is_sarcastic,\n",
    "            'sarcasm_score': min(score, 1.0),\n",
    "            'confidence': 'high' if score > 0.6 else 'medium' if score > 0.35 else 'low',\n",
    "            'evidence': evidence\n",
    "        }\n",
    "\n",
    "    def batch_detect(self, texts):\n",
    "        return [self.detect(t) for t in texts]\n",
    "\n",
    "\n",
    "# Initialize and test\n",
    "sarcasm_detector = SarcasmDetector()\n",
    "\n",
    "# Test cases\n",
    "test_cases = [\n",
    "    (\"Oh wow, another update that breaks everything. You're on a roll! (not).\", True),\n",
    "    (\"Great job making your app worse with every update. Truly impressive incompetence.\", True),\n",
    "    (\"I can't login, please help me reset my password.\", False),\n",
    "    (\"Oh fantastic! My data disappeared AGAIN. Really loving this experience.\", True),\n",
    "    (\"I was charged twice. Please issue a refund as soon as possible.\", False),\n",
    "]\n",
    "\n",
    "print(\"🎭 SARCASM DETECTION RESULTS\")\n",
    "print(\"=\" * 65)\n",
    "correct = 0\n",
    "for text, true_label in test_cases:\n",
    "    result = sarcasm_detector.detect(text)\n",
    "    pred = result['is_sarcastic']\n",
    "    status = '✅' if pred == true_label else '❌'\n",
    "    correct += (pred == true_label)\n",
    "    print(f\"{status} Text: {text[:55]}...\")\n",
    "    print(f\"   True: {true_label} | Pred: {pred} | Score: {result['sarcasm_score']:.2f} | Conf: {result['confidence']}\")\n",
    "    if result['evidence']:\n",
    "        print(f\"   Evidence: {result['evidence'][:2]}\")\n",
    "    print()\n",
    "\n",
    "print(f\"\\n✅ Sarcasm Detection Accuracy: {correct}/{len(test_cases)} = {correct/len(test_cases):.0%}\")"
   ]
