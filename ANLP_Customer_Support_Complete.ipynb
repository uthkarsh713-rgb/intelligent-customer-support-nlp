   "source": [
    "# ============================================================\n",
    "# TOPIC MODELING — Clustering-based approach\n",
    "# ============================================================\n",
    "\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "import nltk\n",
    "nltk.download('stopwords', quiet=True)\n",
    "from nltk.corpus import stopwords\n",
    "\n",
    "stop_words = list(stopwords.words('english'))\n",
    "\n",
    "print(\"Generating embeddings for topic modeling...\")\n",
    "texts = df['text'].tolist()\n",
    "# Use sentence embeddings for better semantic clustering\n",
    "embeddings = embedder.encode(texts[:200], show_progress_bar=True, convert_to_numpy=True)\n",
    "\n",
    "# KMeans clustering\n",
    "n_topics = 8\n",
    "kmeans = KMeans(n_clusters=n_topics, random_state=42, n_init=10)\n",
    "cluster_labels = kmeans.fit_predict(embeddings)\n",
    "\n",
    "# Get top keywords per cluster using TF-IDF\n",
    "tfidf = TfidfVectorizer(max_features=1000, stop_words=stop_words, ngram_range=(1,2))\n",
    "tfidf_matrix = tfidf.fit_transform(texts[:200])\n",
    "feature_names = tfidf.get_feature_names_out()\n",
    "\n",
    "topic_keywords = {}\n",
    "for cluster_id in range(n_topics):\n",
    "    cluster_mask = cluster_labels == cluster_id\n",
    "    if cluster_mask.sum() == 0:\n",
    "        continue\n",
    "    cluster_tfidf = tfidf_matrix[cluster_mask].mean(axis=0).A1\n",
    "    top_indices = cluster_tfidf.argsort()[-5:][::-1]\n",
    "    keywords = [feature_names[i] for i in top_indices]\n",
    "    topic_keywords[cluster_id] = keywords\n",
    "\n",
    "print(\"\\n📌 DISCOVERED TOPICS\")\n",
    "print(\"=\" * 50)\n",
    "for tid, keywords in topic_keywords.items():\n",
    "    count = (cluster_labels == tid).sum()\n",
    "    print(f\"Topic {tid+1} ({count} tickets): {', '.join(keywords)}\")"
   ]
