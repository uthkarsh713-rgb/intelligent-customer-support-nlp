    "    best_match = retrieved[0]\n",
    "\n",
    "    # Tone selection based on sentiment + severity\n",
    "    if sentiment == 'negative' and severity >= 7:\n",
    "        tone = \"apologetic_urgent\"\n",
    "    elif sentiment == 'negative':\n",
    "        tone = \"apologetic\"\n",
    "    elif sentiment == 'positive':\n",
    "        tone = \"friendly\"\n",
    "    else:\n",
    "        tone = \"professional\"\n",
    "\n",
    "    # Tone-based openings\n",
    "    tone_openings = {\n",
