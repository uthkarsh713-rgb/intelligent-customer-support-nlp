    "---\n",
    "## 🔍 STEP 6: Hallucination Detection\n",
    "**Time: ~5 minutes** | Using NLI entailment checking"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# HALLUCINATION DETECTION — NLI Entailment + Fact Checking\n",
    "# ============================================================\n",
    "\n",
    "print(\"Loading NLI model for hallucination detection...\")\n",
    "nli_pipe = pipeline(\n",
    "    'text-classification',\n",
    "    model='cross-encoder/nli-deberta-v3-small',\n",
    "    device=0 if device=='cuda' else -1\n",
    ")\n",
    "print(\"✅ NLI model loaded!\")\n",
    "\n",
    "class HallucinationDetector:\n",
    "    \"\"\"\n",
    "    Detects hallucinations in AI-generated responses using:\n",
    "    1. NLI entailment checking (response vs knowledge base)\n",
    "    2. Factual claim extraction & verification\n",
    "    3. Confidence scoring\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, nli_pipeline, knowledge_base):\n",
    "        self.nli = nli_pipeline\n",
    "        self.kb_responses = [kb['response'] for kb in knowledge_base]\n",
    "        # Known facts for quick lookup\n",
    "        self.known_facts = {\n",
    "            'refund_days': '5-7 business days',\n",
    "            'student_discount': '50%',\n",
    "            'support_hours': 'Monday-Friday 9AM-8PM EST',\n",
    "        }\n",
    "\n",
    "    def check_entailment(self, response, reference):\n",
    "        \"\"\"Check if response is entailed by reference text\"\"\"\n",
    "        result = self.nli(f\"{reference} [SEP] {response}\",\n",
    "                          truncation=True, max_length=512)\n",
    "        label = result[0]['label'].lower()\n",
    "        score = result[0]['score']\n",
    "        return label, score\n",
    "\n",
    "    def detect_fabricated_numbers(self, response):\n",
    "        \"\"\"Flag unverified specific claims (numbers, dates, percentages)\"\"\"\n",
    "        import re\n",
    "        flags = []\n",
    "        # Check for specific numbers not in known facts\n",
    "        numbers = re.findall(r'\\b\\d+[-–]\\d+\\s*(?:business\\s*)?days?\\b', response.lower())\n",
    "        percentages = re.findall(r'\\b\\d+%\\b', response)\n",
    "\n",
    "        verified_nums = ['5-7 business days', '3-5 days', '7-10 days', '48 hours', '24 hours', '2 hours']\n",
    "        for num in numbers:\n",
    "            if not any(v in num.lower() for v in verified_nums):\n",
    "                flags.append(f'Unverified time claim: \"{num}\"')\n",
    "\n",
    "        for pct in percentages:\n",
    "            if pct not in ['50%']:\n",
    "                flags.append(f'Unverified percentage: \"{pct}\"')\n",
    "\n",
    "        return flags\n",
    "\n",
    "    def detect(self, response, retrieved_source):\n",
    "        \"\"\"Full hallucination detection pipeline\"\"\"\n",
    "        results = {}\n",
    "\n",
    "        # 1. NLI entailment check\n",
    "        label, score = self.check_entailment(response[:300], retrieved_source[:300])\n",
    "        results['entailment_label'] = label\n",
    "        results['entailment_score'] = score\n",
    "\n",
    "        # 2. Check for fabricated specifics\n",
    "        fabricated = self.detect_fabricated_numbers(response)\n",
    "        results['fabricated_claims'] = fabricated\n",
    "\n",
    "        # 3. Overall hallucination assessment\n",
    "        hallucination_risk = 'LOW'\n",
    "        if label == 'contradiction' and score > 0.7:\n",
    "            hallucination_risk = 'HIGH'\n",
    "        elif label == 'neutral' or (label == 'contradiction' and score > 0.5):\n",
    "            hallucination_risk = 'MEDIUM'\n",
    "        elif len(fabricated) > 0:\n",
    "            hallucination_risk = 'MEDIUM'\n",
    "\n",
    "        results['hallucination_risk'] = hallucination_risk\n",
    "        results['is_hallucinated'] = hallucination_risk == 'HIGH'\n",
    "        results['factual_consistency_score'] = score if label == 'entailment' else (1 - score)\n",
    "\n",
    "        return results\n",
    "\n",
    "\n",
    "# Initialize detector\n",
    "hallucination_detector = HallucinationDetector(nli_pipe, knowledge_base)\n",
    "\n",
    "# Test cases: (response_text, source_text, expected_hallucination)\n",
    "hall_tests = [\n",
    "    (\n",
    "        \"Your refund will be processed in 5-7 business days and returned to your original payment method.\",\n",
    "        \"Refunds are processed within 5-7 business days. Approved refunds go back to your original payment method.\",\n",
    "        False\n",
    "    ),\n",
    "    (\n",
    "        \"Your refund of $500 has been processed and you'll receive it in 2 hours to your bitcoin wallet.\",\n",
    "        \"Refunds are processed within 5-7 business days. Approved refunds go back to your original payment method.\",\n",
    "        True\n",
    "    ),\n",
    "    (\n",
    "        \"Dark mode is available in Settings → Appearance → Theme → Dark.\",\n",
    "        \"Dark mode is available! Go to Settings → Appearance → Theme → Dark.\",\n",
    "        False\n",
    "    ),\n",
    "    (\n",
    "        \"We offer 90% student discount available to all users.\",\n",
    "        \"We offer 50% off for students with a valid .edu email or student ID.\",\n",
    "        True\n",
    "    ),\n",
    "]\n",
    "\n",
    "print(\"🚨 HALLUCINATION DETECTION RESULTS\")\n",
    "print(\"=\" * 70)\n",
    "correct = 0\n",
    "for response, source, expected in hall_tests:\n",
    "    result = hallucination_detector.detect(response, source)\n",
    "    pred = result['is_hallucinated']\n",
    "    status = '✅' if pred == expected else '❌'\n",
    "    correct += (pred == expected)\n",
    "    print(f\"{status} Response: {response[:65]}...\")\n",
    "    print(f\"   Risk: {result['hallucination_risk']} | Entailment: {result['entailment_label']} ({result['entailment_score']:.2f})\")\n",
    "    if result['fabricated_claims']:\n",
    "        print(f\"   ⚠️ Fabricated: {result['fabricated_claims']}\")\n",
    "    print()\n",
    "\n",
    "print(f\"\\n✅ Hallucination Detection Accuracy: {correct}/{len(hall_tests)} = {correct/len(hall_tests):.0%}\")"
   ]
  },
